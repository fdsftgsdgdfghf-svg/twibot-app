{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/api/catalog/chats", "dest": "/api/catalog/chats.py" },
    { "src": "/api/catalog/chat/([^/]+)", "dest": "/api/catalog/chat.py?chat_id=$1" },
    { "src": "/api/catalog/like/([^/]+)", "dest": "/api/catalog/like.py?chat_id=$1" },
    { "src": "/api/catalog/description/([^/]+)", "dest": "/api/catalog/description.py?chat_id=$1" },
    { "src": "/api/catalog/report/([^/]+)", "dest": "/api/catalog/report.py?chat_id=$1" }
  ]
}
